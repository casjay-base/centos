# Disable reminder in prompt
ignoredirmessage

# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
# ignore commit message
.gitcommit

# Secrets and credential material #
####################################
# The self-signed localhost.key/localhost.crt pair stays committed on purpose
# (kept fine for public per user decision) - only runtime-generated secrets
# that must differ per host are ignored here
etc/ssl/certs/*.key
etc/letsencrypt/
etc/rsyncd.secrets
etc/samba/smbpasswd
