[INCLUDES]
before = paths-fedora.conf

# Fail2Ban configuration file
[DEFAULT]
bantime  = 604800
findtime  = 3600
maxretry = 5
backend = auto
usedns = warn

[fail2ban]
enabled = true
filter = fail2ban
action   = %(banaction)s
logpath = /var/log/fail2ban.log

[ssh]
enabled  = true
filter   = sshd
action   = %(banaction)s
logpath  = /var/log/secure

[proftpd]
enabled  = true
filter   = proftpd
action   = %(banaction)s
logpath  = /var/log/secure
           /var/log/proftpd/auth.log

[postfix]
enabled  = true
filter   = postfix
action   = %(banaction)s
logpath  = /var/log/maillog

[apache]
enabled  = true
filter   = apache-auth
action   = %(banaction)s
logpath  = /var/log/httpd/*error_log

# nginx is the internet-facing TLS terminator, so these jails see the real
# client IP; the apache jail above only ever sees the nginx proxy address
[nginx-http-auth]
enabled  = true
filter   = nginx-http-auth
action   = %(banaction)s
logpath  = /var/log/nginx/error.log

[nginx-botsearch]
enabled  = true
filter   = nginx-botsearch
action   = %(banaction)s
logpath  = /var/log/nginx/access.log

[nginx-limit-req]
enabled  = true
filter   = nginx-limit-req
action   = %(banaction)s
logpath  = /var/log/nginx/error.log

[named-udp]
enabled  = true
filter   = named-refused
action   = %(banaction)s
logpath  = /var/log/named/security.log

[named-tcp]
enabled  = true
filter   = named-refused
action   = %(banaction)s
logpath  = /var/log/named/security.log

[mysqld-auth]
enabled = false
filter  = mysqld-auth
action   = %(banaction)s
logpath = /var/log/mysql/mysql.log

[mssql-auth]
enabled = false
filter  = mssql-auth
action   = %(banaction)s
logpath = /var/opt/mssql/log/errorlog

[dovecot]
enabled  = false
filter   = dovecot
maxretry = 5
bantime  = 3600
findtime  = 120
action   = %(banaction)s
logpath  = /var/log/maillog

[webmin-auth]
enabled = false
filter  = webmin-auth
action   = %(banaction)s
logpath = /var/log/secure

# Long ban for hosts that come back after an earlier ban expires
[recidive]
enabled  = true
filter   = recidive
action   = %(banaction)s
logpath  = /var/log/fail2ban.log
bantime  = 2592000
findtime = 604800
maxretry = 3
